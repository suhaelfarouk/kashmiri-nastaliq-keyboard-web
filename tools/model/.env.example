# Copy to tools/model/.env and fill in real values.
# Scripts do NOT auto-load this file. In each shell session run:
#   set -a && source .env && set +a
#
# Never commit .env or paste real secrets into Git, issues, or chat.

# Hugging Face read token after accepting the gated model terms:
# https://huggingface.co/ai4bharat/indicconformer_stt_ks_hybrid_ctc_rnnt_large
HF_TOKEN=hf_your_read_token

# Cloudflare R2 S3-compatible API credentials
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name

# Public download origin only (r2.dev or custom domain).
# Do NOT use *.r2.cloudflarestorage.com — that is the private S3 API host.
R2_PUBLIC_BASE_URL=https://pub-your-id.r2.dev
